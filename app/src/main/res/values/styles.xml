<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">font/poppins_regular"</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>


    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:fontFamily">font/poppins_regular"</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/bg_input_pill</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Applied to a field's EditText (swap background at runtime) when validation fails:
         editText.setBackgroundResource(R.drawable.bg_input_pill_error);
         and toggle the matching FieldError TextView's visibility to "visible" -->
    <style name="FieldError">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">font/poppins_regular"</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/error_red</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

</resources>
