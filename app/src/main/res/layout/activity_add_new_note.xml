<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8E1E7"
    tools:context=".AddNewNote">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#F8E1E7"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="#33252A"
        android:elevation="0dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Note"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#33252A"
        android:fontFamily="@font/poppins_regular"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Title -->
            <EditText
                android:id="@+id/etNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Title"
                android:inputType="text"
                android:maxLines="1"
                android:padding="15dp"
                android:background="@drawable/edittext_background"
                android:fontFamily="@font/poppins_regular"
                android:textSize="15sp"
                android:textColor="#33252A"
                android:textColorHint="#B79AA1"
                android:layout_marginBottom="14dp" />

            <!-- Tag / label, for note categorization -->
            <EditText
                android:id="@+id/etNoteTag"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Tag (e.g. Work, Personal, Ideas)"
                android:inputType="text"
                android:maxLines="1"
                android:padding="15dp"
                android:background="@drawable/edittext_background"
                android:fontFamily="@font/poppins_regular"
                android:textSize="15sp"
                android:textColor="#33252A"
                android:textColorHint="#B79AA1"
                android:layout_marginBottom="14dp" />

            <!-- Content -->
            <EditText
                android:id="@+id/etNoteContent"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:hint="Write your note here..."
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:padding="18dp"
                android:background="@drawable/edittext_background"
                android:fontFamily="@font/poppins_regular"
                android:textSize="15sp"
                android:textColor="#33252A"
                android:textColorHint="#B79AA1"
                android:layout_marginBottom="14dp" />

            <!-- Creation date, auto-filled in code (e.g. tvNoteDate.setText(currentDate)) -->
            <TextView
                android:id="@+id/tvNoteDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sep 5, 2026"
                android:textSize="12sp"
                android:textColor="#8A6870"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnSaveNote"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="SAVE NOTE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/poppins_regular"
                android:backgroundTint="#D95D7A"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginBottom="30dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>