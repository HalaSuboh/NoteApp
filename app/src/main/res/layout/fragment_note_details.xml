<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8E1E7"
    tools:context=".NoteDetailsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar: back + favorite + delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_back"
                android:background="@android:color/transparent"
                android:contentDescription="Back" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/ivFavoriteToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_favorite"
                app:tint="#D95D7A"
                android:background="@android:color/transparent"
                android:contentDescription="Toggle favorite"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnEmailNote"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_email"
                android:background="@android:color/transparent"
                android:contentDescription="Send by email"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnDeleteNote"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_delete"
                android:background="@android:color/transparent"
                android:contentDescription="Delete note" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <!-- Title -->
            <EditText
                android:id="@+id/etDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Title"
                android:inputType="text"
                android:maxLines="1"
                android:padding="15dp"
                android:background="@drawable/edittext_background"
                android:fontFamily="@font/poppins_regular"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#33252A"
                android:textColorHint="#B79AA1"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDetailTitleError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title cannot be empty"
                android:textSize="12sp"
                android:textColor="#D32F2F"
                android:fontFamily="@font/poppins_regular"
                android:visibility="gone"
                android:layout_marginBottom="6dp" />

            <!-- Date + tag row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvDetailDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sep 5, 2026"
                    android:textSize="12sp"
                    android:textColor="#8A6870"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>

            <!-- Tag -->
            <EditText
                android:id="@+id/etDetailTag"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Tag (e.g. Work, Personal, Ideas)"
                android:inputType="text"
                android:maxLines="1"
                android:padding="14dp"
                android:background="@drawable/edittext_background"
                android:fontFamily="@font/poppins_regular"
                android:textSize="14sp"
                android:textColor="#33252A"
                android:textColorHint="#B79AA1"
                android:layout_marginBottom="14dp" />

            <!-- Content -->
            <EditText
                android:id="@+id/etDetailContent"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:hint="Write your note here..."
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:padding="18dp"
                android:background="@drawable/edittext_background"
                android:fontFamily="@font/poppins_regular"
                android:textSize="15sp"
                android:textColor="#33252A"
                android:textColorHint="#B79AA1"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnSaveNote"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="SAVE CHANGES"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/poppins_regular"
                android:backgroundTint="#D95D7A"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>