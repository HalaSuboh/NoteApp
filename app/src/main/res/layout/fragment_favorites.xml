<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8E1E7"
    tools:context=".FavoritesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Screen title, matches AllNoteFragment's header treatment -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Favorites"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#005254"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- Notes area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/notesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="90dp" />

        </ScrollView>

    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_hero_card"
            android:padding="14dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/img_hero_pencil"
                android:contentDescription="No favorite notes illustration" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No favorite notes yet"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#33252A"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap the heart on any note to add it here"
            android:textSize="13sp"
            android:textColor="#8A6870"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</FrameLayout>