<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8E1E7"
    tools:context=".ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Screen title, matches AllNoteFragment's header treatment -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#005254"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View and edit your account details"
            android:textSize="13sp"
            android:textColor="#8A6870"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="24dp" />

        <!-- Avatar -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_hero_card"
            android:layout_marginBottom="28dp">

            <!-- Using a text glyph here instead of a drawable, since this
                 project's drawable set (checked against the other layouts)
                 doesn't include a profile/person icon. Swap in an
                 ImageView + your own icon if you'd rather have one. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="👤"
                android:textSize="34sp" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <!-- First name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First Name"
                android:textSize="12sp"
                android:textColor="#8A6870"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etProfileFirstName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="First Name"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:padding="15dp"
                android:background="@drawable/edittext_background"
                android:fontFamily="@font/poppins_regular"
                android:textSize="15sp"
                android:textColor="#33252A"
                android:textColorHint="#B79AA1"
                android:layout_marginBottom="16dp" />

            <!-- Last name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Name"
                android:textSize="12sp"
                android:textColor="#8A6870"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etProfileLastName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Last Name"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:padding="15dp"
                android:background="@drawable/edittext_background"
                android:fontFamily="@font/poppins_regular"
                android:textSize="15sp"
                android:textColor="#33252A"
                android:textColorHint="#B79AA1"
                android:layout_marginBottom="16dp" />

            <!-- New password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Password"
                android:textSize="12sp"
                android:textColor="#8A6870"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etProfileNewPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Leave blank to keep current password"
                android:inputType="textPassword"
                android:maxLines="1"
                android:padding="15dp"
                android:background="@drawable/edittext_background"
                android:fontFamily="@font/poppins_regular"
                android:textSize="14sp"
                android:textColor="#33252A"
                android:textColorHint="#B79AA1"
                android:layout_marginBottom="28dp" />

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="SAVE CHANGES"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/poppins_regular"
                android:backgroundTint="#D95D7A"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </LinearLayout>

</ScrollView>